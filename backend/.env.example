# Astraterra CRM Backend - Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL for production)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=astraterra_crm
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Authentication
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# Google Sheets (for data import)
GOOGLE_SHEETS_ID=your_google_sheets_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Pixxi CRM Data API
PIXXI_TOKEN=your_pixxi_token
PIXXI_API_BASE=https://dataapi.pixxicrm.ae

# Telegram alerts (used by scripts/self-heal.js)
# Without TELEGRAM_BOT_TOKEN the self-heal process sends no Telegram messages.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=8117376630

# ── In-house email marketing ────────────────────────────────────────────────
# Public base URL used in tracking pixels / unsubscribe links
PUBLIC_BASE_URL=https://crm.astraterra.ae
EMAIL_FROM_NAME=Astraterra Properties

# SAFETY: emails are dry-run (logged, not sent) unless this is exactly "true".
EMAIL_LIVE=false

# Sending pace + caps
EMAIL_DAILY_LIMIT=2000      # per sender per day
EMAIL_BATCH_SIZE=50         # emails sent per worker tick
EMAIL_TICK_MS=60000         # worker interval (ms)
EMAIL_SCAN_MS=300000        # automation scheduler interval (ms)
EMAIL_MAX_ATTEMPTS=3

# Single Gmail sender (fallback). Scale past 2k/day by using EMAIL_SENDERS below.
GMAIL_USER=admin@astraterra.ae
GMAIL_CLIENT_ID=your_gmail_oauth_client_id
GMAIL_CLIENT_SECRET=your_gmail_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_oauth_refresh_token

# Sender POOL (preferred) — JSON array, each entry ~2k/day. Add accounts to scale.
# EMAIL_SENDERS=[{"email":"admin@astraterra.ae","clientId":"..","clientSecret":"..","refreshToken":"..","dailyLimit":2000},{"email":"news@astraterra.ae","clientId":"..","clientSecret":"..","refreshToken":"..","dailyLimit":2000}]
